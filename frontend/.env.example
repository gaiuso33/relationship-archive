# Frontend configuration (see docs/frontend-auth.md). Copy to `.env.local`, which git ignores.
#
# Every VITE_ variable is embedded in the browser bundle and visible to anyone who opens the site,
# so it must be PUBLIC. Never put a service-role key, a secret key (`sb_secret_...`), the JWT
# secret or any database or backend credential in this file or in any VITE_ variable.

# Your Supabase project URL: https://<project-ref>.supabase.co (public).
VITE_SUPABASE_URL=
# The PUBLISHABLE key (`sb_publishable_...`, or the older "anon" key). Public by design.
VITE_SUPABASE_PUBLISHABLE_KEY=
# The API origin. Use "/" in development so requests go through the Vite proxy.
VITE_API_BASE_URL=/

# Development only, not embedded in the bundle (no VITE_ prefix): where the Vite proxy sends
# /api requests. Defaults to http://127.0.0.1:8000.
# DEV_API_PROXY_TARGET=http://127.0.0.1:8000
