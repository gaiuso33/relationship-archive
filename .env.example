# Local development configuration. Copy this file to `.env` (which git ignores)
# and adjust. Keep only placeholders and non-secret defaults in this file:
# never commit `.env`, credentials, tokens or real personal data.
#
# Later issues add the settings they need.

# Runtime environment: development, test or production.
APP_ENV=development

# Logging. LOG_LEVEL applies to application loggers only; LOG_FORMAT is json or text.
# Both formats apply the same privacy protections (docs/logging-and-errors.md).
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL connection URLs. They must start with postgresql+psycopg://.
# These match the local Docker Compose database in `compose.yaml`. The password is a
# development-only placeholder for your own machine: never reuse it in production or in any
# shared environment, and never put a real password in this file.
DATABASE_URL=postgresql+psycopg://ra_dev:development-only-password@127.0.0.1:5432/relationship_archive
# Dedicated database for automated tests; its name must end in `_test`.
TEST_DATABASE_URL=postgresql+psycopg://ra_dev:development-only-password@127.0.0.1:5432/relationship_archive_test

# Supabase Auth (docs/authentication.md). Your project URL: it is public, not a secret. The
# backend needs no Supabase key. Never put a service-role key or the legacy JWT secret here.
# Required in production; leave empty for local work that does not need sign-in.
SUPABASE_URL=
# The token audience the backend requires. Leave the default unless your project differs.
SUPABASE_JWT_AUDIENCE=authenticated
# Total time allowed to fetch the Supabase signing keys (DNS, connect, TLS, headers and body
# together), in seconds: 1 to 30, default 10. It cannot be disabled. Raise it only if your
# network is slow (docs/authentication.md).
SUPABASE_JWKS_TIMEOUT_SECONDS=10
